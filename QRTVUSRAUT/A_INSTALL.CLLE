     /*          http://www.opensource.org                                  */
     /*          http://www.opensource.org/licenses/gpl-license.html        */
     /*                                                                     */
     /* =================================================================== */
     /*  History:                                                           */
     /*                                                                     */
     /*  Datum       Name          Änderung                                 */
     /*  ----------  ------------  ---------------------------------------  */
     /*                                                                     */
     /* =================================================================== */
     /*   >>PRE-COMPILER<<                                                  */
     /*     >>CRTCMD<<    CRTBNDCL  PGM(QTEMP/&OB) +                        */
     /*                             SRCFILE(&SL/&SF) SRCMBR(&SM);           */
     /*     >>IMPORTANT<<                                                   */
     /*       >>PARM<<    OPTION(*EVENTF);                                  */
     /*     >>END-IMPORTANT<<                                               */
     /*     >>EXECUTE<<                                                     */
     /*     >>CMD<<       CALL   PGM(QTEMP/A_INSTALL) +                     */
     /*                          PARM('*CURRENT' '&SF' '&LI');              */
     /*     >>CMD<<       DLTPGM PGM(QTEMP/A_INSTALL);                      */
     /*   >>END-PRE-COMPILER<<                                              */
     /* =================================================================== */
             PGM        PARM(&TGTRLS &SRCFILE &TOLIB)

             DCL        VAR(&TGTRLS   ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SRCFILE  ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&TOLIB    ) TYPE(*CHAR) LEN(10)

             DCL        VAR(&SRCLIB   ) TYPE(*CHAR) LEN(10)

             DCL        VAR(&PNLGRP   ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DSPF     ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&CMD      ) TYPE(*CHAR) LEN(10)

             CHGVAR     VAR(&SRCLIB) VALUE(&TOLIB   )

             CHGVAR     VAR(&PNLGRP ) VALUE('RTVUSRAUTP')
             CHGVAR     VAR(&CMD    ) VALUE('RTVUSRAUT')

     /* ---------------------------------- */
     /*  Delete old objects                */
     /* ---------------------------------- */
             DLTCMD     CMD(&TOLIB/RTVUSRAUT)
             MONMSG     MSGID(CPF2105)

             DLTPNLGRP  PNLGRP(&TOLIB/RTVUSRAUTP)
             MONMSG     MSGID(CPF2105)

             DLTMOD     MODULE(&TOLIB/RTVUSRA1)
             MONMSG     MSGID(CPF2105)

             DLTPGM     PGM(&TOLIB/RTVUSRAUT)
             MONMSG     MSGID(CPF2105)

     /* -------------------------------- */
     /*  Create modules                  */
     /* -------------------------------- */
             CRTRPGMOD  MODULE(&TOLIB/RTVUSRA1) +
                          SRCFILE(&SRCLIB/&SRCFILE) +
                          SRCMBR(*MODULE) +
                          DBGVIEW(*LIST) TRUNCNBR(*NO) +
                          TGTRLS(&TGTRLS)
             DLTSPLF    FILE(RTVUSRA1) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF0000)

     /* -------------------------------- */
     /*  Create programs                 */
     /* -------------------------------- */
             CRTPGM     PGM(&TOLIB/RTVUSRAUT) +
                        MODULE(&TOLIB/RTVUSRA1) +
                          ACTGRP(*NEW) +
                          DETAIL(*BASIC) +
                          TGTRLS(&TGTRLS)
             DLTSPLF    FILE(RTVUSRAUT) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF0000)

     /* -------------------------------- */
     /*  Create panel groups             */
     /* -------------------------------- */
             CRTPNLGRP  PNLGRP(&TOLIB/RTVUSRAUTP) +
                          SRCFILE(&SRCLIB/&SRCFILE) +
                          SRCMBR(&PNLGRP)
             DLTSPLF    FILE(RTVUSRAUTP) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF0000)

     /* -------------------------------- */
     /*  Create commands                 */
     /* -------------------------------- */
             CRTCMD     CMD(&TOLIB/RTVUSRAUT) PGM(&TOLIB/RTVUSRAUT) +
                          SRCFILE(&SRCLIB/&SRCFILE) +
                          SRCMBR(&CMD) +
                          HLPPNLGRP(&TOLIB/RTVUSRAUTP) HLPID(RTVUSRAUT) +
                          ALLOW(*BPGM *IPGM *BREXX *IREXX *BMOD *IMOD)
             DLTSPLF    FILE(&CMD     ) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF0000)

     /* -------------------------------- */
     /*  Delete obsolete objects         */
     /* -------------------------------- */
             DLTMOD     MODULE(&TOLIB/RTVUSRA1)

             ENDPGM
